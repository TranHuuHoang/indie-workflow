#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_SRC="$ROOT_DIR/skills"
SKILL_NAMES=(context plan execute verify capture)
CONFIG_DIR="${INDIE_WORKFLOW_HOME:-$HOME/.indie-workflow}"
CONFIG_FILE="$CONFIG_DIR/config"
DEFAULT_KB_PATH="$ROOT_DIR/kb"

write_if_missing() {
  local file="$1"
  local content="$2"

  if [[ -e "$file" ]]; then
    return
  fi

  printf "%s\n" "$content" > "$file"
}

check_existing_kb() {
  local kb_dir="$1"
  local has_issue=false
  local style="unknown"

  echo "Detected existing KB: $kb_dir"

  if [[ -e "$kb_dir/index.md" ]]; then
    style="simple"
    echo "Start here: $kb_dir/index.md"
  elif [[ -e "$kb_dir/01_Maps/MOC - Engineering Knowledge Base.md" ]]; then
    style="moc"
    echo "Detected Engineering KB map: $kb_dir/01_Maps/MOC - Engineering Knowledge Base.md"
    echo "Start here: $kb_dir/01_Maps/MOC - Engineering Knowledge Base.md"
  elif [[ -e "$kb_dir/01_Maps/MOC - Knowledge Base.md" ]]; then
    style="moc"
    echo "Detected indie-workflow KB map: $kb_dir/01_Maps/MOC - Knowledge Base.md"
    echo "Start here: $kb_dir/01_Maps/MOC - Knowledge Base.md"
  else
    echo "WARN: no root KB index found."
    echo "      Recommended: $kb_dir/index.md"
    echo "      Also supported:"
    echo "      - $kb_dir/01_Maps/MOC - Knowledge Base.md"
    echo "      - $kb_dir/01_Maps/MOC - Engineering Knowledge Base.md"
    has_issue=true
  fi

  if [[ "$style" == "simple" ]]; then
    for required in index.md inbox projects lessons decisions templates; do
      if [[ ! -e "$kb_dir/$required" ]]; then
        echo "WARN: missing recommended KB path: $kb_dir/$required"
        has_issue=true
      fi
    done
    for template in project-context.md prd.md project-spec.md; do
      if [[ ! -e "$kb_dir/templates/$template" ]]; then
        echo "WARN: missing recommended KB template: $kb_dir/templates/$template"
        has_issue=true
      fi
    done
  elif [[ "$style" == "moc" ]]; then
    for required in 00_Inbox 01_Maps 03_Evergreen 09_Templates; do
      if [[ ! -e "$kb_dir/$required" ]]; then
        echo "WARN: missing recommended KB path: $kb_dir/$required"
        has_issue=true
      fi
    done
    echo "Project notes for MOC-style KBs should use: $kb_dir/02_Projects/{project-name}"
  fi

  if [[ "$has_issue" == true ]]; then
    echo "Existing KB was not modified. Add missing paths manually if you want full alignment."
  else
    echo "Existing KB aligns with indie-workflow ($style style)."
  fi
}

init_kb() {
  local kb_dir="$1"
  local today
  today="$(date +%F)"

  if [[ -d "$kb_dir" ]]; then
    check_existing_kb "$kb_dir"
    return
  fi

  mkdir -p \
    "$kb_dir/inbox" \
    "$kb_dir/projects" \
    "$kb_dir/lessons" \
    "$kb_dir/decisions" \
    "$kb_dir/templates"

  write_if_missing "$kb_dir/index.md" "# Indie Workflow KB

This is the source of truth for indie-workflow: durable project context, engineering lessons, decisions, and learning notes.

Updated: $today

## Areas

| Area | Path | Use for |
|---|---|---|
| Inbox | \`inbox/\` | Raw captures before distillation |
| Projects | \`projects/\` | Project specs, constraints, and durable context |
| Lessons | \`lessons/\` | Reusable engineering lessons and gotchas |
| Decisions | \`decisions/\` | Architecture and product decisions |
| Templates | \`templates/\` | Reusable note templates |

## Rules

- Store durable knowledge here.
- Store implementation in the code repo.
- Store current status in a tracker only if the project needs one.
- Do not store secrets, credentials, tokens, private keys, or raw sensitive logs."

  write_if_missing "$kb_dir/inbox/.gitkeep" ""

  write_if_missing "$kb_dir/projects/README.md" "# Projects

Use this folder for project-level durable context.

Recommended project shape:

\`\`\`text
projects/{project-name}/
├── index.md
├── context.md
├── prd.md
└── lessons.md
\`\`\`"

  write_if_missing "$kb_dir/lessons/README.md" "# Lessons

Use this folder for reusable engineering and domain lessons extracted from projects."

  write_if_missing "$kb_dir/decisions/README.md" "# Decisions

Use this folder for durable architecture, product, and process decisions.

Recommended filename:

\`\`\`text
YYYY-MM-DD-decision-slug.md
\`\`\`"

  if [[ ! -e "$kb_dir/templates/project-spec.md" ]]; then
    cp "$ROOT_DIR/templates/project-spec.md" "$kb_dir/templates/project-spec.md"
  fi
  if [[ ! -e "$kb_dir/templates/project-context.md" ]]; then
    cp "$ROOT_DIR/templates/project-context.md" "$kb_dir/templates/project-context.md"
  fi
  if [[ ! -e "$kb_dir/templates/prd.md" ]]; then
    cp "$ROOT_DIR/templates/prd.md" "$kb_dir/templates/prd.md"
  fi

  echo "Initialized indie-workflow KB: $kb_dir"
  echo "Start here: $kb_dir/index.md"
}

save_kb_path() {
  local kb_dir="$1"

  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" <<EOF
KB_PATH="$kb_dir"
EOF
  echo "Saved KB path: $CONFIG_FILE"
}

is_kb_dir() {
  local dir="$1"

  [[ -d "$dir" ]] || return 1

  [[ -e "$dir/index.md" ]] && return 0
  [[ -e "$dir/01_Maps/MOC - Engineering Knowledge Base.md" ]] && return 0
  [[ -e "$dir/01_Maps/MOC - Knowledge Base.md" ]] && return 0
  [[ -d "$dir/inbox" && -d "$dir/projects" && -d "$dir/lessons" ]] && return 0
  [[ -d "$dir/00_Inbox" && -d "$dir/01_Maps" && -d "$dir/03_Evergreen" ]] && return 0

  return 1
}

discover_home_kb_path() {
  local preferred="$HOME/Engineering-KB"
  local candidates=()
  local dir
  local name

  if is_kb_dir "$preferred"; then
    printf "%s\n" "$preferred"
    return 0
  fi

  for dir in "$HOME"/*; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    case "$name" in
      *KB*|*kb*|*Knowledge*|*knowledge*)
        if is_kb_dir "$dir"; then
          candidates+=("$dir")
        fi
        ;;
    esac
  done

  if [[ "${#candidates[@]}" -eq 1 ]]; then
    printf "%s\n" "${candidates[0]}"
    return 0
  fi

  if [[ "${#candidates[@]}" -gt 1 ]]; then
    echo "WARN: multiple home KB candidates found; using first sorted path. Pass --kb PATH to choose explicitly." >&2
    printf "%s\n" "${candidates[@]}" | sort | head -n 1
    return 0
  fi

  return 1
}

load_configured_kb_path() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return 1
  fi

  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  if [[ -n "${KB_PATH:-}" && -d "$KB_PATH" ]]; then
    printf "%s\n" "$KB_PATH"
    return 0
  fi

  return 1
}

install_target() {
  local label="$1"
  local skills_dir="$2"

  mkdir -p "$skills_dir"

  for skill_name in "${SKILL_NAMES[@]}"; do
    local src="$SKILLS_SRC/$skill_name"
    local target="$skills_dir/$skill_name"

    if [[ ! -d "$src" ]]; then
      echo "Missing skill source: $src" >&2
      exit 1
    fi

    if [[ -L "$target" ]]; then
      current_target="$(readlink "$target")"
      if [[ "$current_target" == "$src" ]]; then
        echo "Already installed for $label: $skill_name"
        continue
      fi
      rm "$target"
      ln -s "$src" "$target"
      echo "Updated stale symlink for $label: $skill_name"
    elif [[ -e "$target" ]]; then
      echo "Refusing to overwrite non-symlink: $target" >&2
      exit 1
    else
      ln -s "$src" "$target"
      echo "Installed for $label: $skill_name"
    fi
  done

  echo "Checked indie-workflow skills for $label: $skills_dir"
}

install_codex=false
install_claude=false
tool_filter=false
kb_path=""

while [[ $# -gt 0 ]]; do
  arg="$1"
  case "$arg" in
    --codex)
      install_codex=true
      tool_filter=true
      shift
      ;;
    --claude)
      install_claude=true
      tool_filter=true
      shift
      ;;
    --kb)
      if [[ $# -lt 2 ]]; then
        echo "--kb requires a path" >&2
        exit 1
      fi
      kb_path="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: ./setup [--kb PATH] [--codex] [--claude]"
      echo ""
      echo "Common:"
      echo "  ./setup                         Install skills and auto-use a home KB if found"
      echo "  ./setup --kb ~/Engineering-KB   Install skills and use this KB"
      echo ""
      echo "Advanced:"
      echo "  ./setup --codex                 Install Codex skills only"
      echo "  ./setup --claude                Install Claude Code skills only"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Usage: ./setup [--kb PATH] [--codex] [--claude]" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$kb_path" ]]; then
  kb_path="$(discover_home_kb_path || true)"
fi

if [[ -z "$kb_path" ]]; then
  kb_path="$(load_configured_kb_path || true)"
fi

if [[ -z "$kb_path" ]]; then
  kb_path="$DEFAULT_KB_PATH"
fi

if [[ "$tool_filter" == false ]]; then
  install_codex=true
  install_claude=true
fi

if [[ "$install_codex" == true ]]; then
  install_target "Codex" "${CODEX_HOME:-$HOME/.codex}/skills"
fi

if [[ "$install_claude" == true ]]; then
  install_target "Claude Code" "$HOME/.claude/skills"
fi

init_kb "$kb_path"
save_kb_path "$kb_path"
